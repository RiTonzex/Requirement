# ==============================================================================
# Django Environment Configuration (.env)
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env สำหรับรันในเครื่อง (Local) หรือนำตัวแปรเหล่านี้ไปใส่ใน
# Vercel Project Settings -> Environment Variables สำหรับการ Deploy บน Vercel
# ==============================================================================

# Core Django Security
# สำหรับ Production บน Vercel ให้ตั้ง SECRET_KEY ใหม่ที่มีความยาวอย่างน้อย 50 ตัวอักษร
SECRET_KEY=your-super-secret-django-key-change-in-production
# บน Vercel ระบบจะตรวจจับและกำหนด DEBUG=False อัตโนมัติเพื่อความปลอดภัย
DEBUG=True
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# ------------------------------------------------------------------------------
# Relational Database: Neon Serverless PostgreSQL (Required)
# ------------------------------------------------------------------------------
# ใช้ Connection Pooling URI จาก Neon Console เพื่อรองรับ Serverless Lambda
DB_ENGINE=postgres
DATABASE_URL=postgresql://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# NoSQL Database: MongoDB Atlas (Optional / Feature: Chat & Portfolio)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=local_worker_db

# ------------------------------------------------------------------------------
# Cloud Media Storage: Cloudinary (Required for file uploads on Vercel)
# ------------------------------------------------------------------------------
# เนื่องจาก Vercel มี File System แบบ Read-Only รูปภาพที่อัปโหลดทั้งหมดจะถูกส่งไปเก็บที่ Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
